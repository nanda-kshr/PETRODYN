# Server Port
PORT=3001

# Simulated Well Identifier
WELL_ID=BW-001

# Telemetry Emission Cadence in Milliseconds (100 - 500 ms recommended)
SIMULATION_INTERVAL_MS=250

# Data Ingestion Target API Endpoint
INGESTION_API_URL=http://localhost:3001/api/v1/ingest

# Simulation Behavior Flags
SIMULATE_TRANSMISSION_FAILURE=false
NOISE_ENABLED=true
